# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*


# vercel
.vercel

# gói đóng sẵn để mang đi
/dist-offline/
scripts/out/

# cấu hình máy (thư mục ra, máy scan đã chọn) — riêng từng máy
/cau-hinh.json

# NAPS2 portable tải về khi đóng gói
/tools/

# nhật ký quét (máy nào cũng có riêng)
/nhat-ky-scan.txt*
